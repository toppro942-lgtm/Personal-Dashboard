# ---- Server ----
PORT=8787
HOST=127.0.0.1
DB_PATH=./data/dashboard.db

# ---- Zugangsschutz (Single-User) ----
# Hash erzeugen mit: npm run init:secrets
DASHBOARD_PASSCODE_HASH=scrypt$<salt-hex>$<hash-hex>
SESSION_SECRET=<64 hex chars>
TOKEN_KEY=<64 hex chars>

# ---- Google OAuth2 (optional) ----
# Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/integrations/google/callback
